# Development/local PostgreSQL database. Replace with the Nexora container credentials.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/nexora

# Dedicated disposable database for pytest integration tests; do not point at production.
TEST_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/nexora_ai_retrieval_test

REDIS_URL=redis://127.0.0.1:6379
EXPRESS_BASE_URL=http://127.0.0.1:3000
TIKA_SERVER_ENDPOINT=http://127.0.0.1:9998

# Local Swagger demo only. Set a random value before starting compose.demo.yml.
AI_SERVICE_API_KEY=replace-with-a-random-secret
AI_API_PORT=8000
HF_CACHE_PATH=./.local/huggingface/hub

# Optional real answer generation via DeepSeek; the adapter pins deepseek-flash.
DEEPSEEK_API_KEY=

# Optional Langfuse v4 tracing. Traces contain evaluator metadata and scores only.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Production should inject DATABASE_URL from deployment secrets, not this file.
